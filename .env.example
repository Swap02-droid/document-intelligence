# The server intentionally binds to loopback only. Do not change this to 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=50
DEFAULT_DPI=250
MAX_RENDER_PIXELS=18000000
MAX_IMAGE_EDGE=5000
MAX_IMAGE_PIXELS=18000000
JOB_RETENTION_MINUTES=60
TEMP_DIR=temp
EXPORT_DIR=temp/exports
# Cactus telemetry must remain disabled for the privacy requirement.
CACTUS_TELEMETRY=0
CACTUS_THREADS=2
